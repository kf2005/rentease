# Settings for docker-compose.yml. Copy to ".env" (same folder) and edit.
# ".env" is git-ignored: never commit real values.

# Password for the PostgreSQL container
DB_PASSWORD=change-me

# Random string, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# First admin account (created automatically on start-up)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
