# Copy to .env for local development. NEVER commit real secrets.
# In the cloud, inject these from AWS Secrets Manager / SSM Parameter Store,
# GitHub Actions secrets, or Docker/Kubernetes secrets (NAME_FILE also works).

APP_ENV=development
PORT=5000

# --- Database (PostgreSQL) ---------------------------------------------
# Either a full URL...
# DATABASE_URL=postgresql://rentease:change-me@localhost:5432/rentease
# ...or separate parts (handy with Amazon RDS):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentease
DB_USER=rentease
DB_PASSWORD=change-me
# Encrypt app-tier -> DB traffic (use "require" on RDS):
# DB_SSLMODE=require
DB_POOL_MAX=10
AUTO_MIGRATE=true

# --- Auth ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_HOURS=24

# First admin account, created on startup if it does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-too
ADMIN_NAME=Site Admin

# --- CORS (only needed when the frontend is served from another origin) --
CORS_ORIGINS=http://localhost:8080

# --- Image storage -------------------------------------------------------
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# STORAGE_BACKEND=s3
# S3_BUCKET=rentease-uploads-xxxx
# S3_PREFIX=uploads/
# AWS_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://dxxxxxxxx.cloudfront.net   (optional; otherwise pre-signed URLs)
MAX_IMAGE_MB=5
MAX_IMAGES_PER_PROPERTY=8

LOG_LEVEL=INFO
